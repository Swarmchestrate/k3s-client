apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    persistence:
      enabled: true
      existingClaim: {{ persistent_volume_claim }}
      path: {{ persistent_mount_path }}
    additionalArguments:
      - "--certificatesresolvers.{{ cert_resolver }}.acme.email={{ acme_email }}"
      - "--certificatesresolvers.{{ cert_resolver }}.acme.storage={{ acme_storage_path }}"
      - "--certificatesresolvers.{{ cert_resolver }}.acme.tlschallenge=true"
      - "--certificatesresolvers.{{ cert_resolver }}.acme.tlschallenge.delay=10s"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ persistent_volume_claim }}
  namespace: {{ persistent_volume_claim_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ persistent_volume_claim_size }}